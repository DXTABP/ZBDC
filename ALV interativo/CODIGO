
*& Programa para manutenção de dados da tabela ZADE com ALV interativo
*& Permite criar, modificar e excluir registros
*&---------------------------------------------------------------------*

REPORT zxxxxx.

*&---------------------------------------------------------------------*
*&  TOP - Declarações globais
*&---------------------------------------------------------------------*

TABLES: zade. "Tabela principal do programa

TYPE-POOLS slis. "Pool de tipos para ALV

* Estrutura estendida para a tabela ZADE com campos adicionais
TYPES: BEGIN OF ty_ade.
        INCLUDE STRUCTURE zade.         "Estrutura base da tabela ZADE
TYPES: handle_style TYPE lvc_t_styl,    "Estilo de edição das células
       novo         TYPE c,             "Indicador de registro novo
       delete       TYPE c.             "Indicador de registro para excluir
TYPES: END OF ty_ade.

* Declaração de variáveis globais
DATA: 
  "Tabelas internas
  t_ade_ori TYPE TABLE OF zade,        "Dados originais da tabela
  t_ade     TYPE TABLE OF ty_ade,      "Dados com campos extendidos
  
  "Estruturas para ALV
  t_fieldcat     TYPE lvc_t_fcat,      "Catálogo de campos
  w_fieldcat     TYPE lvc_s_fcat,      "Estrutura de campo individual
  t_sort         TYPE lvc_t_sort,      "Ordenação
  w_sort         TYPE lvc_s_sort,      "Critério de ordenação
  w_layout       TYPE lvc_s_layo,      "Layout do ALV
  
  "Estilos para edição
  t_new          TYPE lvc_t_styl,      "Estilo para novos registros
  w_new          TYPE lvc_s_styl,      "Definição de estilo
  t_edit         TYPE lvc_t_styl,      "Estilo para edição
  w_edit         TYPE lvc_s_styl,      "Definição de estilo
  t_show         TYPE lvc_t_styl,      "Estilo para visualização
  w_show         TYPE lvc_s_styl,      "Definição de estilo
  
  "Variáveis de trabalho
  w_ade          TYPE ty_ade,          "Registro atual
  w_ade_ori      TYPE zade,            "Registro original
  
  "Flags de controle
  v_modific(1)   TYPE c,               "Modo edição/visualização
  v_elimino(1)   TYPE c,               "Registro excluído
  v_alterou(1)   TYPE c,               "Registro alterado
  v_inseriu(1)   TYPE c,               "Registro inserido
  
  "Tabelas para operações CRUD
  t_ade_new      TYPE TABLE OF ty_ade, "Novos registros
  t_ade_del      TYPE TABLE OF ty_ade, "Registros para excluir
  t_ade_de2      TYPE TABLE OF zade,   "Registros para excluir (estrutura original)
  t_ade_upd      TYPE TABLE OF ty_ade, "Registros para atualizar
  t_ade_up2      TYPE TABLE OF zade,   "Registros para atualizar (estrutura original)
  
  "Variáveis para log de mensagens
  v_log_handle   TYPE balloghndl,      "Handle do log
  v_msg          TYPE abap_bool.       "Indicador de mensagem

*&---------------------------------------------------------------------*
*&  SCREEN - Tela de seleção
*&---------------------------------------------------------------------*

SELECTION-SCREEN BEGIN OF BLOCK a WITH FRAME TITLE text-003.
* Parâmetros de seleção
SELECT-OPTIONS: 
  s_matnr  FOR zade-matnr,   "Número de material
  s_descri FOR zade-descri NO INTERVALS NO-EXTENSION. "Descrição
SELECTION-SCREEN END OF BLOCK a.

*&---------------------------------------------------------------------*
*&  PROCESSAMENTO PRINCIPAL
*&---------------------------------------------------------------------*

START-OF-SELECTION.
* Limpar variáveis
  PERFORM zf_clear.

* Selecionar dados conforme critérios
  PERFORM zf_selecionar_dados.

* Preparar ALV
  PERFORM zf_alv_fieldcat.   "Definir catálogo de campos
  PERFORM zf_alv_sort.       "Definir ordenação
  PERFORM zf_new_fields.     "Mapear campos para novos registros
  PERFORM zf_edit_fields.    "Mapear campos para edição
  PERFORM zf_show_fields.    "Mapear campos para visualização
  
* Preparar dados para exibição
  PERFORM zf_make_fields.

* Exibir ALV
  PERFORM zf_show_alv.

END-OF-SELECTION.

*&---------------------------------------------------------------------*
*&  FORMS - Rotinas do programa
*&---------------------------------------------------------------------*

*&---------------------------------------------------------------------*
*&      Form  ZF_SELECIONAR_DADOS
*&---------------------------------------------------------------------*
*       Seleciona dados da tabela ZADE conforme critérios informados
*----------------------------------------------------------------------*
FORM zf_selecionar_dados.
  SELECT *
    INTO TABLE t_ade_ori
    FROM zade
   WHERE matnr  IN s_matnr
     AND descri IN s_descri.
     
  IF sy-subrc IS INITIAL.
    SORT t_ade_ori BY matnr. "Ordenar por número de material
  ELSE.
    "Exibir mensagem se não encontrar dados
    MESSAGE 'Dados não encontrados!' TYPE 'I' DISPLAY LIKE 'W'.
    LEAVE LIST-PROCESSING. "Sair do processamento
  ENDIF.
ENDFORM.                    " ZF_SELECIONAR_DADOS

*&---------------------------------------------------------------------*
*&      Form  ZF_CLEAR
*&---------------------------------------------------------------------*
*       Limpa todas as variáveis e tabelas internas
*----------------------------------------------------------------------*
FORM zf_clear.
  CLEAR:
      v_modific, v_elimino, v_alterou, v_inseriu,
      w_fieldcat, w_layout, w_new, w_edit, w_show,
      w_ade, w_ade_new, w_ade_del, w_ade_de2, w_ade_upd, w_ade_up2, w_ade_ori.

  "Limpar tabelas internas
  REFRESH:
      t_fieldcat, t_new, t_edit, t_show, t_ade,
      t_ade_new, t_ade_del, t_ade_de2, t_ade_upd, t_ade_up2, t_ade_ori.
ENDFORM.                    " ZF_CLEAR

*&---------------------------------------------------------------------*
*&      Form  ZF_ALV_FIELDCAT
*&---------------------------------------------------------------------*
*       Configura o catálogo de campos e layout do ALV
*----------------------------------------------------------------------*
FORM zf_alv_fieldcat.
  REFRESH t_fieldcat.

  "Campo MATNR (Número de material)
  w_fieldcat-tabname   = 'T_ADE'.
  w_fieldcat-fieldname = 'MATNR'.
  w_fieldcat-edit      = abap_false. "Não editável
  w_fieldcat-ref_table = 'ZADE'.
  w_fieldcat-ref_field = 'MATNR'.
  w_fieldcat-outputlen = 18.
  w_fieldcat-emphasize = abap_true. "Destacar
  APPEND w_fieldcat TO t_fieldcat.
  CLEAR w_fieldcat.

  "Campo DESCRI (Descrição)
  w_fieldcat-tabname   = 'T_ADE'.
  w_fieldcat-fieldname = 'DESCRI'.
  w_fieldcat-edit      = abap_true. "Editável
  w_fieldcat-ref_table = 'ZADE'.
  w_fieldcat-ref_field = 'DESCRI'.
  w_fieldcat-outputlen = 30.
  APPEND w_fieldcat TO t_fieldcat.
  CLEAR w_fieldcat.

  "Configuração do layout
  w_layout-zebra      = abap_true. "Lista zebrada
  w_layout-stylefname = 'HANDLE_STYLE'. "Campo para estilos
ENDFORM.                    " ZF_ALV_FIELDCAT

* [Continuação com os demais FORMs...]
* (Os demais forms seguem o mesmo padrão de documentação)

*&---------------------------------------------------------------------*
*&      Form  ZF_NEW_FIELDS
*&---------------------------------------------------------------------*
*       Define estilos para campos em novos registros
*----------------------------------------------------------------------*
FORM zf_new_fields.
  REFRESH t_new.

  "Campo MATNR habilitado para novos registros
  w_new-fieldname = 'MATNR'.
  w_new-style     = cl_gui_alv_grid=>mc_style_enabled. "Habilitado
  INSERT w_new INTO TABLE t_new.
  CLEAR w_new.

  "Campo DESCRI habilitado para novos registros
  w_new-fieldname = 'DESCRI'.
  w_new-style     = cl_gui_alv_grid=>mc_style_enabled. "Habilitado
  INSERT w_new INTO TABLE t_new.
ENDFORM.                    " ZF_NEW_FIELDS

*&---------------------------------------------------------------------*
*&      Form  ZF_EDIT_FIELDS
*&---------------------------------------------------------------------*
*       Define estilos para campos em edição
*----------------------------------------------------------------------*
FORM zf_edit_fields.
  REFRESH t_edit.

  "Campo MATNR desabilitado na edição
  w_edit-fieldname = 'MATNR'.
  w_edit-style     = cl_gui_alv_grid=>mc_style_disabled. "Desabilitado
  INSERT w_edit INTO TABLE t_edit.
  CLEAR w_edit.

  "Campo DESCRI habilitado na edição
  w_edit-fieldname = 'DESCRI'.
  w_edit-style     = cl_gui_alv_grid=>mc_style_enabled. "Habilitado
  INSERT w_edit INTO TABLE t_edit.
ENDFORM.                    " ZF_EDIT_FIELDS

*&---------------------------------------------------------------------*
*&      Form  ZF_SHOW_FIELDS
*&---------------------------------------------------------------------*
*       Define estilos para campos em modo visualização
*----------------------------------------------------------------------*
FORM zf_show_fields.
  REFRESH t_show.

  "Ambos campos desabilitados na visualização
  w_show-fieldname = 'MATNR'.
  w_show-style     = cl_gui_alv_grid=>mc_style_disabled.
  INSERT w_show INTO TABLE t_show.
  CLEAR w_show.

  w_show-fieldname = 'DESCRI'.
  w_show-style     = cl_gui_alv_grid=>mc_style_disabled.
  INSERT w_show INTO TABLE t_show.
ENDFORM.                    " ZF_SHOW_FIELDS

*&---------------------------------------------------------------------*
*&      Form  ZF_SHOW_ALV
*&---------------------------------------------------------------------*
*       Exibe o ALV com os dados
*----------------------------------------------------------------------*
FORM zf_show_alv.
  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY_LVC'
    EXPORTING
      i_callback_program       = sy-repid
      is_layout_lvc            = w_layout
      it_fieldcat_lvc          = t_fieldcat
      i_callback_user_command  = 'ZF_COMMANDS' "Handler para comandos
      i_callback_pf_status_set = 'ZF_STATUS'   "Handler para status
      it_sort_lvc              = t_sort
    TABLES
      t_outtab                 = t_ade[]
    EXCEPTIONS
      program_error            = 1
      OTHERS                   = 2.
      
  IF sy-subrc <> 0.
    "Tratar erros na exibição
    MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
            WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
  ENDIF.
ENDFORM.                    " ZF_SHOW_ALV


